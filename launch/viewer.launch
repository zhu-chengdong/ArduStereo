<launch>
  <arg name="config" default="$(find ardustereo)/config/b0266.yaml"/>
  <arg name="port" default="8765"/>
  <arg name="camera_ns" default="camera"/>
  <arg name="root" default="$(env HOME)/ardustereo_gui"/>
  <node pkg="ardustereo" type="viewer.py" name="ardustereo_viewer" output="screen" required="true"
        args="--config '$(arg config)' --port $(arg port) --camera-ns '$(arg camera_ns)' --root '$(arg root)' --package-dir '$(find ardustereo)'"/>
</launch>
